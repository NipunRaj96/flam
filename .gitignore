# ── Private Specs & Non-Feature Documents ─────────────────────────────────
build-plan/
build-plan
task.md

# ── Secrets & Credentials ──────────────────────────────────────────────────
# Keep .env.example tracked, ignore real credentials
secrets/.env
.env
.env.*
!.env.example
!secrets/.env.example
*.pem
*.key

# ── Temporary / Scratch Files ──────────────────────────────────────────────
temp/
scratch/

# ── Runtime Artifacts & Telemetry ──────────────────────────────────────────
# Keep directory placeholders (.gitkeep) but ignore actual logs & screenshots
logs/*
!logs/.gitkeep
receipts/*
!receipts/.gitkeep

# ── SQLite Database Files ──────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Python Cache & Virtual Environments ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
env/
ENV/

# ── Testing & Playwright Artifacts ─────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── OS Metadata ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDE & Editor Configuration ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
