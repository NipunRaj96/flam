# Copy this file to secrets/.env and fill in your values.
# NEVER commit secrets/.env to git.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# SQLite database path (default is fine)
DATABASE_URL=sqlite+aiosqlite:///./flam.db

# Daily submission cap per user
MAX_DAILY_SUBMISSIONS=20

# Groq API key (used for resume extraction, GitHub README summarization, and answer generation)
GROQ_API_KEY=your_groq_api_key_here

# Vision / Career Page confidence threshold (default: 0.8)
VISION_CONFIDENCE_THRESHOLD=0.8
