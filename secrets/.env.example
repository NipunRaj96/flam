# Copy this file to secrets/.env and fill in your values.
# NEVER commit secrets/.env to git.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# SQLite database path (default is fine)
DATABASE_URL=sqlite+aiosqlite:///./flam.db

# Daily submission cap per user
MAX_DAILY_SUBMISSIONS=20

# Groq API key (used for resume extraction, GitHub README summarization, and answer generation)
GROQ_API_KEY=your_groq_api_key_here

# Vision / Career Page confidence threshold (default: 0.8)
VISION_CONFIDENCE_THRESHOLD=0.8

# Groq model for answers, email drafts and reading screenshots (default: qwen/qwen3.8-27b)
# GROQ_MODEL=qwen/qwen3.8-27b
# Optional different model for screenshots only
# GROQ_VISION_MODEL=

# IMPORTANT: your Telegram user id (message @userinfobot to find it).
# Comma-separate several. If empty, ANYONE who finds the bot can use it.
ALLOWED_TELEGRAM_IDS=

# Optional, only for automatic Gmail sending (not required: emails open in Gmail ready to send)
# GOOGLE_CLIENT_ID=
# OAUTH_REDIRECT_URI=
